{
  "name": "@mm/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=../../.env.development src/cli/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../.env.development src/cli/seed.ts",
    "setup-token": "tsx --env-file-if-exists=../../.env.development src/cli/setup-token.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --env-file-if-exists=../../.env.development ../../node_modules/vitest/vitest.mjs run"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@mm/core": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "license": "AGPL-3.0-or-later"
}
