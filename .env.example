# Copy to .env and fill in. Secrets do NOT go here; they live in ./secrets (pnpm keys:generate).

# The exact URL you'll open in the browser. Passkeys are bound to this hostname.
#   Tailscale:  https://<TS_HOSTNAME>.<your-tailnet>.ts.net
#   Cloudflare: https://money.example.com
APP_URL=https://money.your-tailnet.ts.net

# tailscale | cloudflare
ACCESS_MODE=tailscale

# Your time zone (an IANA name such as America/Chicago). It decides when "today" and a new
# budget month begin, and what time the schedules below (digest, backups) run. Default: UTC.
TZ=UTC

# Optional services to run: your access method, plus "backup" for nightly encrypted backups.
COMPOSE_PROFILES=tailscale,backup

# ── Tailscale (docker compose --profile tailscale up -d) ──
# One-time auth key from https://login.tailscale.com/admin/settings/keys (only needed on first start).
TS_AUTHKEY=
TS_HOSTNAME=money
# Optional: only these tailnet logins may reach the app (comma-separated).
TAILSCALE_ALLOWED_USERS=

# ── Cloudflare Tunnel + Access (docker compose --profile cloudflare up -d) ──
CLOUDFLARE_TUNNEL_TOKEN=
# e.g. yourteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# The Access application's "Application Audience (AUD) Tag"
CF_ACCESS_AUD=

# ── Plaid (optional, bring your own keys: https://dashboard.plaid.com) ──
# Broader coverage than SimpleFIN, including investments. Sandbox is free; production needs Plaid's approval.
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# For OAuth banks (Chase, Capital One…): register this exact URL in the Plaid dashboard.
# PLAID_REDIRECT_URI=https://money.your-tailnet.ts.net/settings/connections/oauth

# ── Teller (optional, https://teller.io) ──
# Development/production need your Teller client certificate. See docs/self-hosting.md.
# TELLER_APPLICATION_ID=
# TELLER_ENV=sandbox

# ── AI (optional, bring your own key: https://console.anthropic.com) ──
# Enables Ask, AI categorization and the weekly digest. Each household's owner must still
# opt in under Settings → AI, after seeing exactly what gets shared.
# ANTHROPIC_API_KEY=
# AI_MODEL=   # optional; leave unset for the app's default model
# Weekly digest (Mondays 8am) and monthly card catalog check (the 3rd, 9am), as cron
# expressions in your TZ.
# DIGEST_CRON=0 8 * * 1
# CATALOG_REFRESH_CRON=0 9 3 * *

# ── Notifications (ntfy) ──
# Set to 1 if you run your own ntfy server on your LAN or tailnet. Without it, ntfy URLs
# that resolve to private addresses are refused (and http:// is not allowed).
# NTFY_ALLOW_PRIVATE=1

# ── Backups (profile: backup) ──
# Default is a local Docker volume. For off-site copies (recommended), use e.g.
#   Cloudflare R2:  s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>
#   Backblaze B2:   b2:<bucket>:money-manager
# RESTIC_REPOSITORY=/backups/restic
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_B2_ACCOUNT_ID=
# BACKUP_B2_ACCOUNT_KEY=
# BACKUP_TIME=03:30

# ── Published images (see docs/upgrading.md) ──
# MM_IMAGE_PREFIX=ghcr.io/nathanielnoyd/money-manager
# MM_VERSION=0.1.0

# ── AGPL: if you run a MODIFIED version for others, link to your source ──
# SOURCE_URL=https://github.com/you/money-manager-fork

# ── Optional ──
# SYNC_INTERVAL_HOURS=6
# SIMPLEFIN_ALLOWED_HOSTS=simplefin.org
# SYNC_CRON=*/15 * * * *
# LOG_LEVEL=info
# The name passkey prompts show for this site.
# APP_NAME=Money Manager
# Extra arguments for `tailscale up` (for example --advertise-tags=tag:money).
# TS_EXTRA_ARGS=
